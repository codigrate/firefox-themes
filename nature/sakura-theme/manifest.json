{
  "manifest_version": 2,
  "name": "Codigrate Sakura",
  "version": "2026.1.27",
  "description": "A light Firefox theme inspired by Sakura, featuring soft pink tones, rose accents, and gentle spring colors.",
  "author": "Codigrate",
  "homepage_url": "https://codigrate.com/theme?product=sakura&category=nature",
  "browser_specific_settings": {
    "gecko": {
      "id": "sakura-theme@codigrate.com",
      "strict_min_version": "109.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#F8DBE6",
      "frame_inactive": "#F8DBE6",
      "tab_background_text": "#94667D",
      "tab_selected": "#FCF4F7",
      "tab_text": "#3D0013",
      "tab_line": "#B54B66",
      "tab_loading": "#B54B66",
      "tab_background_separator": "#94667D",
      "toolbar": "#FCF4F7",
      "toolbar_text": "#3D0013",
      "icons": "#B54B66",
      "icons_attention": "#EFA5BF",
      "button_background_hover": "#FFD6E0",
      "button_background_active": "#FFC9DC",
      "toolbar_top_separator": "#F8DBE6",
      "toolbar_bottom_separator": "#F8DBE6",
      "toolbar_vertical_separator": "#F8DBE6",
      "toolbar_field": "#FFFFFF",
      "toolbar_field_text": "#3D0013",
      "toolbar_field_border": "#F8DBE6",
      "toolbar_field_focus": "#FFFFFF",
      "toolbar_field_text_focus": "#3D0013",
      "toolbar_field_border_focus": "#DE849E",
      "toolbar_field_highlight": "#FFC9DC",
      "toolbar_field_highlight_text": "#3D0013",
      "popup": "#FCF4F7",
      "popup_text": "#3D0013",
      "popup_border": "#F8DBE6",
      "popup_highlight": "#FFC9DC",
      "popup_highlight_text": "#3D0013",
      "sidebar": "#FCF4F7",
      "sidebar_text": "#3D0013",
      "sidebar_border": "#F8DBE6",
      "sidebar_highlight": "#FFC9DC",
      "sidebar_highlight_text": "#3D0013",
      "ntp_background": "#FEFCFC",
      "ntp_card_background": "#FCF4F7",
      "ntp_text": "#3D0013"
    },
    "properties": {
      "color_scheme": "light"
    }
  }
}
