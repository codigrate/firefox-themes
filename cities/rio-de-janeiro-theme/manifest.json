{
  "manifest_version": 3,
  "name": "Codigrate Rio de Janeiro",
  "version": "2026.1.24",
  "description": "A light Firefox theme inspired by Rio de Janeiro, featuring tropical greens, sunny warmth, and fresh vibrant accents.",
  "author": "Codigrate",
  "homepage_url": "https://codigrate.com/theme?product=rio-de-janeiro&category=cities",
  "browser_specific_settings": {
    "gecko": {
      "id": "rio-de-janeiro-theme@codigrate.com",
      "strict_min_version": "156.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#85B778",
      "frame_inactive": "#85B778",
      "tab_background_text": "#2D7B18",
      "tab_selected": "#D9EFD2",
      "tab_text": "#1A510A",
      "tab_line": "#375B2E",
      "tab_loading": "#375B2E",
      "tab_background_separator": "#2D7B18",
      "toolbar": "rgba(255, 255, 255, 0.4)",
      "toolbar_text": "#1A510A",
      "icons": "#375B2E",
      "icons_attention": "#2287D5",
      "button_background_hover": "#B4DEA8",
      "button_background_active": "#B8E5AD",
      "toolbar_top_separator": "rgba(0, 0, 0, 0)",
      "toolbar_bottom_separator": "#85B778",
      "toolbar_vertical_separator": "#85B778",
      "toolbar_field": "#FFFFFF",
      "toolbar_field_text": "#1A510A",
      "toolbar_field_border": "#85B778",
      "toolbar_field_focus": "#FFFFFF",
      "toolbar_field_text_focus": "#1A510A",
      "toolbar_field_border_focus": "#47A731",
      "toolbar_field_highlight": "#B8E5AD",
      "toolbar_field_highlight_text": "#1A510A",
      "popup": "#D9EFD2",
      "popup_text": "#1A510A",
      "popup_border": "#85B778",
      "popup_highlight": "#B8E5AD",
      "popup_highlight_text": "#1A510A",
      "sidebar": "#D9EFD2",
      "sidebar_text": "#1A510A",
      "sidebar_border": "#85B778",
      "sidebar_highlight": "#B8E5AD",
      "sidebar_highlight_text": "#1A510A",
      "ntp_background": "#F8FBF7",
      "ntp_card_background": "#D9EFD2",
      "ntp_text": "#1A510A"
    },
    "images": {
      "additional_backgrounds": [
        {
          "linear-gradient": "to right, #89B17E 0%, #77BA66 100%"
        }
      ]
    },
    "properties": {
      "color_scheme": "light",
      "additional_backgrounds_tiling": [
        "no-repeat"
      ],
      "additional_backgrounds_size": [
        "auto"
      ],
      "backgrounds_area": "window"
    }
  }
}
