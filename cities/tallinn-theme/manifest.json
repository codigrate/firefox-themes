{
  "manifest_version": 2,
  "name": "Codigrate Tallinn",
  "version": "2026.1.23",
  "description": "A light Firefox theme inspired by Tallinn, featuring cool Nordic blues, soft frosty tones, and elegant accents.",
  "author": "Codigrate",
  "homepage_url": "https://codigrate.com/theme?product=tallinn&category=cities",
  "browser_specific_settings": {
    "gecko": {
      "id": "tallinn-theme@codigrate.com",
      "strict_min_version": "109.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#A9B9DA",
      "frame_inactive": "#A9B9DA",
      "tab_background_text": "#184092",
      "tab_selected": "#D0DCEF",
      "tab_text": "#0F244F",
      "tab_line": "#3F4494",
      "tab_loading": "#3F4494",
      "tab_background_separator": "#184092",
      "toolbar": "#D0DCEF",
      "toolbar_text": "#0F244F",
      "icons": "#3F4494",
      "icons_attention": "#7179CC",
      "button_background_hover": "#B8D0F3",
      "button_background_active": "#BECCEC",
      "toolbar_top_separator": "#A9B9DA",
      "toolbar_bottom_separator": "#A9B9DA",
      "toolbar_vertical_separator": "#A9B9DA",
      "toolbar_field": "#FFFFFF",
      "toolbar_field_text": "#0F244F",
      "toolbar_field_border": "#A9B9DA",
      "toolbar_field_focus": "#FFFFFF",
      "toolbar_field_text_focus": "#0F244F",
      "toolbar_field_border_focus": "#7A96D0",
      "toolbar_field_highlight": "#BECCEC",
      "toolbar_field_highlight_text": "#0F244F",
      "popup": "#D0DCEF",
      "popup_text": "#0F244F",
      "popup_border": "#A9B9DA",
      "popup_highlight": "#BECCEC",
      "popup_highlight_text": "#0F244F",
      "sidebar": "#D0DCEF",
      "sidebar_text": "#0F244F",
      "sidebar_border": "#A9B9DA",
      "sidebar_highlight": "#BECCEC",
      "sidebar_highlight_text": "#0F244F",
      "ntp_background": "#F8FAFF",
      "ntp_card_background": "#D0DCEF",
      "ntp_text": "#0F244F"
    },
    "properties": {
      "color_scheme": "light"
    }
  }
}
